{
  "name": "basic-lit-example",
  "version": "0.1.0",
  "description": "Basic example project using Lit with Vite",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "keywords": [
    "lit",
    "web-components",
    "typescript",
    "library",
    "proof of concept"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristopherDavenport/basic-lit-example.git"
  },
  "bugs": {
    "url": "https://github.com/ChristopherDavenport/basic-lit-example/issues"
  },
  "homepage": "https://github.com/ChristopherDavenport/basic-lit-example",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@lit/context": "^1.1.3",
    "@lit/task": "^1.0.2",
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
